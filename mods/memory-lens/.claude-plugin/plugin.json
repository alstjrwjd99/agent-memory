{
  "name": "memory-lens",
  "version": "0.6.0",
  "description": "agent-memory 패널: 작업 흐름이 주인공(+ 다른 작업들), 기억은 쓰일 때/새로 생길 때만 표시, recall 주입",
  "types": "./types/index.d.ts",
  "userConfig": {
    "machine": {
      "type": "string",
      "title": "PC 이름",
      "description": "amem config의 machine과 같게 (예: mac, win-work)",
      "default": "mac"
    },
    "store": {
      "type": "string",
      "title": "personal store 경로",
      "description": "비우면 ~/workspace/memory-personal",
      "default": ""
    },
    "workStore": {
      "type": "string",
      "title": "work store 경로",
      "description": "비우면 ~/workspace/memory-work (없으면 표시 안 함)",
      "default": ""
    },
    "engineDir": {
      "type": "string",
      "title": "엔진 경로",
      "description": "agent-memory/engine 절대경로 (비우면 ~/workspace/agent-memory/engine)",
      "default": ""
    },
    "recall": {
      "type": "boolean",
      "title": "recall 사용",
      "description": "프롬프트마다 관련 기억을 찾아 Claude에게 함께 전달",
      "default": true
    },
    "flow": {
      "type": "boolean",
      "title": "작업 흐름 표시",
      "description": "턴이 끝날 때 haiku로 흐름 요약 (턴당 약 $0.001)",
      "default": true
    },
    "flowModel": {
      "type": "string",
      "title": "흐름 요약 모델",
      "description": "기본 haiku",
      "default": "haiku"
    }
  }
}